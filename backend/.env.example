# --- database: Supabase "Session pooler" URI (IPv4, port 5432). URL-encode special characters in the password. ---
DATABASE_URL=postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# (local: postgresql://vista:vista@localhost:5432/vista)

# --- who can sign in as staff (set both when the site is public) ---
STAFF_ACCESS_CODE=change-me-to-a-long-code
SECRET_KEY=generate-a-long-random-string
SESSION_HOURS=12
# Platform owner (Super Admin): a code of their own, different from the staff code. Needs SECRET_KEY too.
SUPER_ADMIN_CODE=another-long-code
ADMIN_LINK_DAYS=14         # how long the Admin's sign-in link from the Super Admin works (spent once the Admin sets a password)
APPROVAL_DAYS=7            # how long the approve/decline link in the household email works

# 0 = the shared staff code stops signing people in (sessions made with it end too); only personal accounts (email + password) do.
# Turn off once everyone has a password. Keep STAFF_ACCESS_CODE set: it is what switches off the demo-mode role headers.
STAFF_CODE_LOGIN=1
# AUTH_MODE=dev            # leave as is (demo mode only applies when STAFF_ACCESS_CODE is empty)

# --- first start ---
AUTO_MIGRATE=1
AUTO_BOOTSTRAP=1            # creates the empty village (1 gate, 20 passes) if it does not exist
AUTO_SEED=0                 # 1 = load demo households and visits instead (testing only)
# SEED_PASSWORD=             # demo/testing only: with AUTO_SEED=1, gives the seeded Admin, guard and HOA accounts this password (10+ characters)
DEFAULT_PROPERTY=greenfield-village-7f3a
VILLAGE_NAME=Greenfield Village
PASS_COUNT=20

# --- CORS: the React app on Vercel calls this API. Comma separated, no trailing slash. ---
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
# CORS_ORIGIN_REGEX=https://your-app-.*\.vercel\.app    # optional: Vercel preview deployments

# --- the Vercel address: household invitation links point here (no trailing slash) ---
FRONTEND_URL=https://your-app.vercel.app
INVITE_DAYS=30              # how long a household sign-in link works
# ALLOW_DEMO_AUTH=1         # Render refuses to start without STAFF_ACCESS_CODE unless you set this (throwaway demos only)

# --- rules ---
MISSING_HOURS=3
PHOTO_RETENTION_DAYS=30
TIMEZONE=Asia/Manila
RATE_LIMIT_PER_MIN=60
# Staff sign-in attempts per IP per minute (slows access-code guessing). Keep the default in production.
LOGIN_RATE_LIMIT_PER_MIN=20
# How many proxies sit in front of the API (Render = 1). The rate limiter trusts only the address the last proxy added to X-Forwarded-For.
TRUST_PROXY_HOPS=1

# --- keep the 3-hour Missing flag running on a host that sleeps (free plans) ---
CRON_KEY=another-long-random-string

# --- optional ---
DB_SSL=auto                 # auto = SSL for supabase hosts. require | disable
DB_PGBOUNCER=               # 1 if you use the transaction pooler without ?pgbouncer=true
ENABLE_RLS=1               # close the Supabase REST API on the tables this app created (never on a platform's own tables)
SCHEMA_CHECK=1             # at start, check that tables a platform already owns fit Vista. 0 = skip
DB_POOL_MAX=8

# --- EMAIL (QR code to the visitor AND to the household after an approval; approval links; invitations) ---
# The platform's email tool is EmailJS (HTTPS, works on Render free). Step by step: HOSTING.md step 3 and EMAIL-SETUP.md.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=        # needed because the API calls EmailJS from a server (also enable it in EmailJS: Account > Security)
# The public address of this API, so the template can show the QR picture with <img src="{{qr_url}}">. On Render it is filled in by itself.
PUBLIC_API_URL=

# --- OPTIONAL, laptop only: Gmail by SMTP (Render free blocks SMTP). EmailJS above is used first when it is set. ---
# Gmail: turn on 2-Step Verification, then make an App Password: https://myaccount.google.com/apppasswords
# Put ONLY these lines in backend/.env, restart the API, then run:  python mailtest.py you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls      # starttls (port 587) | ssl (port 465) | none
SMTP_USER=                  # your full Gmail address
SMTP_PASSWORD=              # the 16-letter App Password (spaces are fine), NOT your normal password
SMTP_FROM=                  # optional, defaults to SMTP_USER
SMTP_FROM_NAME=Vista VMS
# MAX_BODY_BYTES=3000000      # largest request body the API accepts (photos are about 2 MB as base64)
# MAX_MAP_BODY_BYTES=12000000 # the village map import
